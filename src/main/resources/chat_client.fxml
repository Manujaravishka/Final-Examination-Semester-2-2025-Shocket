<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.text.Font?>

<AnchorPane style="-fx-background-color: #6d7573; -fx-background-radius: 10px;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.chat_application_shocket.Client.ChatClient">

    <!-- Header -->
    <AnchorPane layoutX="0.0" layoutY="0.0" prefHeight="80.0" prefWidth="700.0" style="-fx-background-color: #d9d9d9; -fx-background-radius: 10px;">
        <children>
            <!-- Profile Image -->
            <ImageView fitHeight="50.0" fitWidth="50.0" layoutX="15.0" layoutY="15.0" pickOnBounds="true" preserveRatio="true">

            </ImageView>

            <!-- Client Name -->
            <Label layoutX="308.0" layoutY="14.0" text="Client">
                <font>
                    <Font name="System Bold Italic" size="36.0" />
                </font>
            <textFill>
               <LinearGradient endX="1.0" endY="1.0" startX="0.680952380952381">
                  <stops>
                     <Stop>
                        <color>
                           <Color />
                        </color>
                     </Stop>
                     <Stop offset="1.0">
                        <color>
                           <Color red="1.0" green="1.0" blue="1.0" />
                        </color>
                     </Stop>
                  </stops>
               </LinearGradient>
            </textFill>
            </Label>
         <Label layoutX="83.0" layoutY="33.0" text="Online" textFill="#14720f">
            <font>
               <Font name="FreeMono Bold Oblique" size="15.0" />
            </font>
         </Label>
         <Label layoutX="65.0" prefHeight="50.0" prefWidth="12.0" text="." textFill="#33a453">
            <font>
               <Font name="System Bold" size="40.0" />
            </font>
         </Label>
         <Button fx:id="btndisconnected" layoutX="568.0" layoutY="28.0" mnemonicParsing="false" onAction="#btnDisconnectedOnAction" style="-fx-background-radius: 10px;" text="Disconnected" textFill="#ff1919">
            <font>
               <Font name="System Bold Italic" size="13.0" />
            </font>
         </Button>
        </children>
    </AnchorPane>

    <!-- Messages List -->
    <ListView fx:id="messageView" layoutX="15.0" layoutY="100.0" prefHeight="400.0" prefWidth="670.0" style="-fx-background-radius: 10px;" />

    <!-- Input Area -->
    <AnchorPane layoutX="15.0" layoutY="506.0" prefHeight="50.0" prefWidth="670.0" style="-fx-background-color: #f2f2f2; -fx-background-radius: 10px;">
        <children>
            <!-- Message Input -->
            <TextField fx:id="txtMessage" layoutX="10.0" layoutY="10.0" prefHeight="30.0" prefWidth="470.0" promptText="Type your message..." />

            <!-- Image Button -->
            <Button fx:id="btnImage" layoutX="490.0" layoutY="10.0" onAction="#btnImageOnAction" prefHeight="30.0" prefWidth="60.0" style="-fx-background-radius: 10px;" text="+">
            <font>
               <Font name="System Bold Italic" size="14.0" />
            </font>
            <textFill>
               <LinearGradient endX="1.0" endY="1.0" startX="0.08095238095238096" startY="0.16666666666666666">
                  <stops>
                     <Stop>
                        <color>
                           <Color />
                        </color>
                     </Stop>
                     <Stop offset="1.0">
                        <color>
                           <Color red="0.5" green="0.08796296268701553" blue="0.08796296268701553" />
                        </color>
                     </Stop>
                  </stops>
               </LinearGradient>
            </textFill></Button>

            <!-- Send Button -->
            <Button fx:id="btnSend" layoutX="560.0" layoutY="10.0" onAction="#btnSendOnAction" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: Black; -fx-background-radius: 10px;" text="Send" textFill="WHITE">
            <font>
               <Font name="System Bold Italic" size="13.0" />
            </font></Button>
        </children>
    </AnchorPane>
</AnchorPane>
