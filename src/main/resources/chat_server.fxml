<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.chat_application_shocket.server.ChatServer">

    <children>
        <!-- Header -->
        <AnchorPane layoutX="0.0" layoutY="0.0" prefHeight="80.0" prefWidth="700.0" style="-fx-background-color: #4e5697;">
            <children>
                <!-- Server Icon -->
                <Label layoutX="25.0" layoutY="20.0" textFill="black">
                    <font>
                        <Font size="28.0" />
                    </font>
                </Label>

                <!-- Server Title -->
                <Label layoutX="70.0" layoutY="25.0" text="Chat Server">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>

                <!-- Add Client Button -->
                <Button fx:id="addClientBtn" layoutX="540.0" layoutY="20.0" onAction="#btnAddClientOnAction" prefHeight="35.0" prefWidth="130.0" style="-fx-background-radius: 10px;" text="Add Client" />
            </children>
        </AnchorPane>

        <!-- Server Logs -->
        <AnchorPane layoutX="20.0" layoutY="101.0" prefHeight="370.0" prefWidth="660.0" style="-fx-background-color: #f2f2f2;">
            <children>
                <Label layoutX="15.0" layoutY="10.0" text="Server Logs" textFill="black">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>

                <TextArea fx:id="txtServerStatus" layoutX="10.0" layoutY="40.0" prefHeight="310.0" prefWidth="640.0" promptText="Server logs will appear here..." />
            </children>
        </AnchorPane>

        <!-- Footer Info -->
        <Label layoutX="20.0" layoutY="480.0" text="Server running on port 12345" textFill="gray">
            <font>
                <Font size="11.0" />
            </font>
        </Label>
    </children>
</AnchorPane>
